# EduERP Backend Security & Authentication Configuration
# Copy to .env for local development (never commit .env with real secrets)

# Secret key for signing JWT session tokens (generate a random 32+ char string)
JWT_SECRET=

# Optional initial Admin provisioning on first server boot (recommended via `npm run create-admin` CLI)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=System Administrator

# 2FA Authenticator App Issuer Name
ADMIN_TOTP_ISSUER=EduERP

# Optional SMTP settings for live Admin 2FA / Recovery Email OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@eduerp.edu
