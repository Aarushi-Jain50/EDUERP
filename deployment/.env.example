# EduERP System Environment Template

# App Configuration
PORT=3000
NODE_ENV=development

# Backend Service
BACKEND_PORT=4000
BACKEND_API_URL=http://localhost:4000/api

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eduerp
POSTGRES_USER=eduerp_user
POSTGRES_PASSWORD=eduerp_secure_password

# Firebase (Optional)
FIREBASE_PROJECT_ID=eduerp-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@eduerp-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
